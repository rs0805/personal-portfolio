---
const name = "Harshitaa Kashyap";
const role = "Full-Stack Developer";
---

<div class="hero-art">
  <div class="profile-circle">
    <img src="/pics/01.jpeg" alt="A picture of me" />
  </div>

  <div class="id-name">
    <div class="id-full">{name}</div>
    <div class="id-role">{role}</div>
  </div>

  <div class="divider"></div>
</div>

<style>
  .hero-art {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    width: 100%;
  }

  .profile-circle {
    width: 280px;
    height: 280px;
    position: relative;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--accent);
  }

  .profile-circle img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .profile-circle::before,
  .profile-circle::after {
    content: "";
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .profile-circle::before {
    inset: 12px;
    border: 1px dashed var(--accent);
    opacity: 0.45;
  }

  .profile-circle::after {
    inset: 32px;
    border: 1px solid var(--accent);
    opacity: 0.2;
  }

  .id-name {
    text-align: center;
  }

  .id-full {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0.04em;
  }

  .id-role {
    margin-top: 4px;
    font-size: 0.8rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .divider {
    width: 100%;
    margin-top: 8px;
    border-top: 1px dashed var(--border);
  }

  @media (max-width: 768px) {
    .profile-circle {
      width: 220px;
      height: 220px;
    }

    .id-full {
      font-size: 1.2rem;
    }
  }
</style>