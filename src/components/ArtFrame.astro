---
interface Props {
  label?: string;
  status?: string;
}
const { label = "~", status = "ONLINE" } = Astro.props;
---

<div class="frame">
  <span class="bolt tl">+</span>
  <span class="bolt tr">+</span>
  <span class="bolt bl">+</span>
  <span class="bolt br">+</span>

  <div class="content">
    <slot />
  </div>

  <div class="status">
    <span class="dot"></span>
    <span class="status-text">{label}</span>
    <span class="status-text dim">— {status}</span>
  </div>
</div>

<style>
  .frame {
    position: relative;
    padding: 28px 22px 18px;
    border: 1px dashed var(--border);
    border-radius: 4px;
    background: linear-gradient(180deg, #0c0c0c, #0a0a0a);
    min-height: 480px;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 18px;
    color: var(--text);
    flex: 1;
  }

  .bolt {
    position: absolute;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1;
  }
  .bolt.tl { top: 6px;    left: 8px;  }
  .bolt.tr { top: 6px;    right: 8px; }
  .bolt.bl { bottom: 6px; left: 8px;  }
  .bolt.br { bottom: 6px; right: 8px; }

  .content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 0;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    letter-spacing: .12em;
    color: var(--text-dim);
    border-top: 1px dashed var(--border);
    padding-top: 10px;
    text-transform: uppercase;
  }

  .status .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-2);
    box-shadow: 0 0 8px var(--accent-2);
    animation: pulse 1.6s ease-in-out infinite;
  }

  .status-text.dim { color: var(--text-faint); }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: .35; }
  }

  @media (prefers-reduced-motion: reduce) {
    .status .dot { animation: none; }
  }

  @media (max-width: 960px) {
    .frame { min-height: 0; }
  }
</style>
