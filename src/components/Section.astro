---
interface Props {
  id: string;
  title: string;
  kicker?: string;
}
const { id, title, kicker } = Astro.props;
---

<section id={id} class="section">
  {kicker && <div class="section-title">{kicker}</div>}
  <h2 class="heading">{title}</h2>
  <div class="content">
    <slot />
  </div>
</section>

<style>
  .section {
    padding: 28px 0 8px;
    scroll-margin-top: 90px;
  }
  .section + .section {
    border-top: 1px dashed var(--border);
    margin-top: 16px;
    padding-top: 32px;
  }
  .heading {
    font-size: 1.35rem;
    margin: 0 0 14px;
    letter-spacing: -.01em;
  }
  .content { color: var(--text-dim); }
</style>
