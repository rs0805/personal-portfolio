---
import BaseLayout from "../layouts/BaseLayout.astro";
import TopNav     from "../components/TopNav.astro";
import HeroArt    from "../components/art/HeroArt.astro";
import { Icon } from "astro-icon/components";

const skills = {
  Languages:    ["Python", "SQL", "Go"],
  Technologies: ["FastAPI", "Go-Fiber", "GORM", "REST APIs", "React", "Vitest", "Docker", "AWS", "GitHub Actions"],
  Core:         ["Data Structures", "Algorithms", "OOP", "Database Systems", "Networks"],
};

const galleries: Record<string, { src: string; alt: string }[]> = {
  acmw: [
    { src: "/pics/acmw/01.jpeg", alt: "ACM-W VIT — moment 01" },
    { src: "/pics/acmw/02.jpeg", alt: "ACM-W VIT — moment 02" },
    { src: "/pics/acmw/03.jpeg", alt: "ACM-W VIT — moment 03" },
  ],
};
---

<BaseLayout
  title="Harshitaa Kashyap"
  description="Harshitaa Kashyap — final-year CSE @ VIT Vellore. Backend & full-stack developer. Currently interning at Sanofi."
>
  <TopNav />

  <main class="rows">

    <section class="row" id="hero" data-spy="about">
      <aside class="art-col">
        <HeroArt />
      </aside>

      <article class="content-col">
        <div class="content-inner hero">
          <p class="hero-prompt">
            <span class="prompt">~</span>
            <span class="dollar">$</span>
            <span class="typewriter">cat about.txt</span><span class="caret">_</span>
