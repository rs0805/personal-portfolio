  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
    <button class="lb-btn lb-close" type="button" aria-label="Close">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="6" y1="6" x2="18" y2="18"/>
        <line x1="18" y1="6" x2="6" y2="18"/>
      </svg>
    </button>
    <button class="lb-btn lb-prev" type="button" aria-label="Previous photo">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="15 6 9 12 15 18"/>
      </svg>
    </button>
    <figure class="lb-figure">
      <img class="lb-img" alt="" />
      <figcaption class="lb-caption"></figcaption>
    </figure>
    <button class="lb-btn lb-next" type="button" aria-label="Next photo">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="9 6 15 12 9 18"/>
      </svg>
    </button>
    <div class="lb-counter" aria-live="polite"></div>
  </div>

  <script>
    document.querySelectorAll<HTMLElement>(".exp-grid .card").forEach((card) => {
      card.addEventListener("click", (event) => {
        if ((event.target as HTMLElement).closest("a")) return;
        card.classList.toggle("is-flipped");
      });
      card.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          if ((event.target as HTMLElement).closest("a")) return;
          event.preventDefault();
          card.classList.toggle("is-flipped");
        }
      });
    });

    /* expandable photo strips ------------------------------------- */
    document.querySelectorAll<HTMLButtonElement>(".hl-toggle").forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("aria-controls");
        if (!targetId) return;
        const panel = document.getElementById(targetId);
        if (!panel) return;
        const expanded = btn.getAttribute("aria-expanded") === "true";
        btn.setAttribute("aria-expanded", String(!expanded));
        if (expanded) {
          panel.classList.remove("is-open");
          panel.addEventListener(
            "transitionend",
            () => { if (btn.getAttribute("aria-expanded") === "false") panel.hidden = true; },
            { once: true },
          );
        } else {
          panel.hidden = false;
          requestAnimationFrame(() => panel.classList.add("is-open"));
        }
      });
    });

    /* lightbox ---------------------------------------------------- */
    const lb       = document.getElementById("lightbox") as HTMLElement | null;
    const lbImg    = lb?.querySelector<HTMLImageElement>(".lb-img") ?? null;
    const lbCap    = lb?.querySelector<HTMLElement>(".lb-caption") ?? null;
    const lbCount  = lb?.querySelector<HTMLElement>(".lb-counter") ?? null;
    const lbPrev   = lb?.querySelector<HTMLButtonElement>(".lb-prev") ?? null;
    const lbNext   = lb?.querySelector<HTMLButtonElement>(".lb-next") ?? null;
    const lbClose  = lb?.querySelector<HTMLButtonElement>(".lb-close") ?? null;

    let lbItems: { src: string; alt: string }[] = [];
    let lbIndex = 0;
    let lbReturnFocus: HTMLElement | null = null;

    const render = () => {
      if (!lb || !lbImg || !lbCap || !lbCount) return;
      const item = lbItems[lbIndex];
      lbImg.src   = item.src;
      lbImg.alt   = item.alt;
      lbCap.textContent  = item.alt;
      lbCount.textContent = `${lbIndex + 1} / ${lbItems.length}`;
      const many = lbItems.length > 1;
      lbPrev?.toggleAttribute("hidden", !many);
      lbNext?.toggleAttribute("hidden", !many);
      lbCount.toggleAttribute("hidden", !many);
    };

    const openLb = (items: { src: string; alt: string }[], index: number, returnTo: HTMLElement) => {
      if (!lb) return;
      lbItems = items;
      lbIndex = index;
      lbReturnFocus = returnTo;
      render();
      lb.hidden = false;
      requestAnimationFrame(() => lb.classList.add("is-open"));
      document.body.style.overflow = "hidden";
      lbClose?.focus();
    };

    const closeLb = () => {
      if (!lb) return;
      lb.classList.remove("is-open");
      lb.addEventListener("transitionend", () => { lb.hidden = true; }, { once: true });
      document.body.style.overflow = "";
      lbReturnFocus?.focus();
    };

    const stepLb = (delta: number) => {
      if (!lbItems.length) return;
      lbIndex = (lbIndex + delta + lbItems.length) % lbItems.length;
      render();
    };

    document.querySelectorAll<HTMLButtonElement>(".hl-thumb").forEach((thumb) => {
      thumb.addEventListener("click", () => {
        const panel = thumb.closest<HTMLElement>(".hl-photos");
        if (!panel) return;
        const items = Array.from(panel.querySelectorAll<HTMLButtonElement>(".hl-thumb"))
          .map((t) => ({ src: t.dataset.src ?? "", alt: t.dataset.alt ?? "" }));
        const idx = Number(thumb.dataset.index ?? 0);
        openLb(items, idx, thumb);
      });
    });

    lbClose?.addEventListener("click", closeLb);
    lbPrev?.addEventListener("click", () => stepLb(-1));
    lbNext?.addEventListener("click", () => stepLb(1));
    lb?.addEventListener("click", (event) => {
      if (event.target === lb) closeLb();
    });
    document.addEventListener("keydown", (event) => {
      if (lb?.hidden) return;
      if (event.key === "Escape")     closeLb();
      if (event.key === "ArrowLeft")  stepLb(-1);
      if (event.key === "ArrowRight") stepLb(1);
    });
  </script>
</BaseLayout>

