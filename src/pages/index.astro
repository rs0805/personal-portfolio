---
import BaseLayout from "../layouts/BaseLayout.astro";
import TopNav from "../components/TopNav.astro";
import HeroArt from "../components/art/HeroArt.astro";
import { Icon } from "astro-icon/components";

const skills = {
  Languages: ["Python", "SQL", "Go"],
  Technologies: [
    "FastAPI",
    "Go-Fiber",
    "GORM",
    "REST APIs",
    "React",
    "Vitest",
    "Docker",
    "AWS",
    "GitHub Actions",
  ],
  Core: [
    "Data Structures",
    "Algorithms",
    "OOP",
    "Database Systems",
    "Networks",
  ],
};

const galleries: Record<string, { src: string; alt: string; label: string }[]> =
  {
    acmw: [
      { src: "/pics/acmw/01.jpeg", alt: "ACM-W VIT — moment 01", label: "01" },
      { src: "/pics/acmw/02.jpeg", alt: "ACM-W VIT — moment 02", label: "02" },
      { src: "/pics/acmw/03.jpeg", alt: "ACM-W VIT — moment 03", label: "03" },
    ],
    car: [
      { src: "/pics/car/1.png", alt: "UniPool — screen 01", label: "1.png" },
      { src: "/pics/car/2.png", alt: "UniPool — screen 02", label: "2.png" },
      { src: "/pics/car/3.png", alt: "UniPool — screen 03", label: "3.png" },
    ],
    mp: [
      { src: "/pics/mp/i.png", alt: "mp3by4 — screen 01", label: "i.png" },
      { src: "/pics/mp/ii.png", alt: "mp3by4 — screen 02", label: "ii.png" },
    ],
    sanofi: [
      {
        src: "/pics/sanofi/01.jpeg",
        alt: "Sanofi internship project",
        label: "01",
      },
    ],
  };
---

<BaseLayout
  title="Harshitaa Kashyap"
  description="Harshitaa Kashyap — final-year CSE @ VIT Vellore. Backend & full-stack developer. Currently interning at Sanofi."
>
  <TopNav />

  <main class="rows">
    <section class="row" id="hero" data-spy="about">
      <aside class="art-col">
        <HeroArt />
      </aside>

      <article class="content-col">
        <div class="content-inner hero">
          <p class="hero-prompt">
            <span class="prompt">~</span>
            <span class="dollar">$</span>
            <span class="typewriter">cat about.txt</span><span class="caret"
              >_</span
            >
          </p>

          <h1 class="hero-title">
            Hi, I'm <span class="hero-name">Harshitaa Kashyap</span>.
          </h1>

          <p class="hero-tagline">
            Final-year CSE undergrad at VIT Vellore. I build backend systems and
            full-stack web apps, currently a Digital R&amp;D intern at
            <span class="kw">Sanofi</span>, working on an AI-powered virtual
            lab.
          </p>

          <div class="hero-actions">
            <a class="btn btn-primary" href="/contact">
              <span>Contact</span>
              <svg
                viewBox="0 0 24 24"
                width="14"
                height="14"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path
                  d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                ></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </a>

            <div class="hero-socials">
              <a
                href="https://github.com/harshitaak07"
                aria-label="GitHub"
                target="_blank"
                rel="noreferrer"
              >
                <Icon name="mdi:github" />
              </a>

              <a
                href="https://www.linkedin.com/in/harshitaa-kashyap"
                aria-label="LinkedIn"
                target="_blank"
                rel="noreferrer"
              >
                <Icon name="mdi:linkedin" />
              </a>

              <a
                href="https://leetcode.com/u/Harshitaa_Kashyap"
                aria-label="LeetCode"
                target="_blank"
                rel="noreferrer"
              >
                <Icon name="simple-icons:leetcode" />
              </a>
              <a
                href="https://drive.google.com/file/d/1EYV78ffmPzQwk0RiDMHMsCwciKlVngEO/view?usp=sharing"
                aria-label="Resume"
                target="_blank"
                rel="noreferrer"
              >
                <Icon name="mdi:file-document-outline" />
              </a>
            </div>
          </div>

          <div class="hero-now">
            <div class="now-item">
              <div class="now-icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="2" y="7" width="20" height="14" rx="2"></rect>
                  <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"></path>
                  <path d="M2 13h20"></path>
                </svg>
              </div>
              <div class="now-body">
                <div class="now-key">Currently</div>
                <div class="now-val">
                  Digital R&amp;D Intern @ <span class="kw">Sanofi</span>
                </div>
              </div>
            </div>

            <div class="now-item">
              <div class="now-icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                  ></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div class="now-body">
                <div class="now-key">Based in</div>
                <div class="now-val">Hyderabad, India &middot; IST</div>
              </div>
            </div>

            <div class="now-item">
              <div class="now-icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M12 2l2.39 4.84L20 7.27l-3.91 3.81.92 5.38L12 13.77l-5.01 2.69.92-5.38L4 7.27l5.61-.43L12 2z"
                  ></path>
                </svg>
              </div>
              <div class="now-body">
                <div class="now-key">Open to</div>
                <div class="now-val">Backend &amp; Full-stack roles</div>
              </div>
            </div>
          </div>

          <a href="#about" class="scroll-cue" aria-label="Scroll to about">
            <span>scroll</span>
            <svg
              viewBox="0 0 24 24"
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <polyline points="19 12 12 19 5 12"></polyline>
            </svg>
          </a>
        </div>
      </article>
    </section>

    <section class="row row-full section" id="about">
      <article class="content-col content-col-full">
        <div class="content-inner about-inner">
          <div class="section-title">// section_01</div>
          <h2 class="heading heading-lg">About</h2>

          <div class="about-prose">
            <p>
              I'm a CS student who enjoys building things. Lately that's mostly
              been Python, Go, React, and whatever else a project needs. I like
              writing clean code, keeping things simple, and making sure they
              actually work.
            </p>
            <p>
              Apart from coding I like to draw, read and sing :)
            </p>
          </div>

          <div class="subblock subblock-lg">
            <div class="subblock-head">
              <div>
                <span class="subblock-title"
                  >Vellore Institute of Technology, Vellore</span
                >
                <span class="tag">B.Tech CSE</span>
              </div>
              <div class="subblock-meta">Graduating Jul 2026</div>
            </div>
            <div class="subblock-sub">CGPA: 8.57</div>
          </div>

          <div class="section-title skills-kicker">// skills</div>
          <div class="skills-lines">
            {
              Object.entries(skills).map(([group, items]) => (
                <div class="skill-line">
                  <span class="skill-line-key">{group}</span>
                  <span class="skill-line-values">
                    {items.map((it, i) => (
                      <>
                        {i > 0 && <span class="sep"> · </span>}
                        <span class="item">{it}</span>
                      </>
                    ))}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </article>
    </section>

    <section class="row row-full section" id="experience">
      <article class="content-col content-col-full">
        <div class="content-inner exp-inner">
          <div class="section-title">// section_02</div>
          <h2 class="heading heading-lg">Experience</h2>

          <p class="term-prompt-line">
            <span class="term-user">harshitaa@portfolio</span><span
              class="term-colon">:</span
            ><span class="term-path">~</span><span class="term-dollar">$</span>
            <span class="term-cmd">git log --oneline --graph ~/career</span
            ><span class="term-caret">_</span>
          </p>

          <div class="timeline">
            <div class="timeline-item">
              <div class="timeline-marker"></div>

              <div class="timeline-content">
                <p class="exp-commit">
                  <span class="exp-commit-kw">commit</span>
                  <span class="exp-commit-hash">e7f3a02</span>
                </p>
                <p class="exp-date-line">
                  <span class="exp-meta-kw">Date:</span>
                  <span class="exp-date-val">MAY 2025 — JUL 2025</span>
                </p>

                <h3>Mphasis</h3>

                <div class="timeline-role">Summer Intern</div>

                <ul class="term-list">
                  <li>
                    Monitored and managed oracle and weblogic tomcat
                    environments to ensure stable application availability.
                  </li>

                  <li>
                    Redesigned and documented testing workflows to improve
                    deployment reliability and efficiency.
                  </li>
                </ul>

                <div class="term-divider" aria-hidden="true"></div>

                <p class="stack-line">
                  <span class="stack-hash">#</span> stack:
                  <span class="stack-chips">
                    <span class="stack-chip">Java</span>
                    <span class="stack-chip">Shell Scripting</span>
                    <span class="stack-chip">CI/CD</span>
                  </span>
                </p>
              </div>
            </div>

            <div class="timeline-item current">
              <div class="timeline-marker"></div>

              <div class="timeline-content">
                <p class="exp-commit">
                  <span class="exp-commit-kw">commit</span>
                  <span class="exp-commit-hash">a1b9c4d</span>
                  <span class="exp-commit-ref">(HEAD → current)</span>
                </p>
                <p class="exp-date-line">
                  <span class="exp-meta-kw">Date:</span>
                  <span class="exp-date-val">JAN 2026 — JUL 2026</span>
                </p>

                <h3>Sanofi</h3>

                <div class="timeline-role">Digital R&amp;D Intern</div>

                <div class="sanofi-row">
                  <ul class="term-list">
                    <li>
                      Contributed to Lavoisier, an AI-powered virtual lab.
                    </li>

                    <li>Built OAuth2, SAML and MSAL authentication flows.</li>

                    <li>Increased testing coverage by 45%.</li>
                  </ul>
                  <div class="timeline-gallery">
                    {
                      galleries.sanofi.map((p, i) => (
                        <button
                          class="hl-thumb term-shot"
                          type="button"
                          data-index={i}
                          data-src={p.src}
                          data-alt={p.alt}
                          aria-label={`Open Sanofi image ${i + 1}`}
                        >
                          <span class="term-shot-frame">
                            <img src={p.src} alt={p.alt} loading="lazy" />
                          </span>
                          <span class="term-shot-name">{p.label}</span>
                        </button>
                      ))
                    }
                  </div>
                </div>

                <div class="term-divider" aria-hidden="true"></div>

                <p class="stack-line">
                  <span class="stack-hash">#</span> stack:
                  <span class="stack-chips">
                    <span class="stack-chip">React</span>
                    <span class="stack-chip">TypeScript</span>
                    <span class="stack-chip">FastAPI</span>
                    <span class="stack-chip">OAuth2</span>
                    <span class="stack-chip">Vitest</span>
                  </span>
                </p>
              </div>
            </div>
          </div>
        </div>
      </article>
    </section>

    <section class="row row-full section" id="projects">
      <article class="content-col content-col-full">
        <div class="content-inner project-inner">
          <div class="section-title">// section_03</div>
          <h2 class="heading heading-lg">Projects</h2>

          <p class="term-prompt-line">
            <span class="term-user">harshitaa@portfolio</span><span
              class="term-colon">:</span
            ><span class="term-path">~</span><span class="term-dollar">$</span>
            <span class="term-cmd">ls -1 ~/projects</span><span
              class="term-caret">_</span
            >
          </p>

          <div class="project-list">
            <article class="project-item term-card">
              <header class="term-bar">
                <span class="term-dots" aria-hidden="true">
                  <span class="term-dot term-dot-red"></span>
                  <span class="term-dot term-dot-amber"></span>
                  <span class="term-dot term-dot-green"></span>
                </span>
                <span class="term-file"
                  >~/projects/mp3by4.md<span class="term-file-mode">
                    (read-only)</span
                  ></span
                >
                <a
                  class="term-action"
                  href="https://github.com/harshitaak07/mp3by4"
                  target="_blank"
                  rel="noreferrer"
                >
                  repository →
                </a>
              </header>

              <div class="term-body">
                <p class="term-cmd-line">
                  <span class="term-dollar">$</span> cat ~/projects/mp3by4.md<span
                    class="term-caret">_</span
                  >
                </p>

                <h3>mp3by4</h3>

                <p>
                  Built a Chrome extension that transforms web articles into narrated video
                  summaries using automated content extraction, text-to-speech, and media
                  processing workflows.
                </p>
                
                <div class="term-body-grid">
                  <ul class="term-list">
                    <li>
                      Implemented webpage extraction and summarization for article-to-video generation.
                    </li>
                    <li>
                      Developed video processing and foreground isolation using OpenCV and MediaPipe.
                    </li>
                    <li>
                      Combined narration audio and processed video into final MP4 outputs.
                    </li>
                  </ul>
                </div>
                
                  <div class="term-shots term-shots-inline" data-gallery="mp">
                    {
                      galleries.mp.map((p, i) => (
                        <button
                          class="hl-thumb term-shot"
                          type="button"
                          data-index={i}
                          data-src={p.src}
                          data-alt={p.alt}
                          aria-label={`Open mp3by4 screenshot ${i + 1} of ${galleries.mp.length}`}
                        >
                          <span class="term-shot-frame">
                            <img src={p.src} alt={p.alt} loading="lazy" />
                          </span>
                          <span class="term-shot-name">{p.label}</span>
                        </button>
                      ))
                    }
                  </div>
                </div>

                <div class="term-divider" aria-hidden="true"></div>

                <p class="stack-line">
                  <span class="stack-hash">#</span> stack:
                  <span class="stack-chips">
                    <span class="stack-chip">Python</span>
                    <span class="stack-chip">OpenCV</span>
                    <span class="stack-chip">MediaPipe</span>
                    <span class="stack-chip">Chrome Extension</span>
                  </span>
                </p>
              </div>
            </article>

            <article class="project-item term-card">
              <header class="term-bar">
                <span class="term-dots" aria-hidden="true">
                  <span class="term-dot term-dot-red"></span>
                  <span class="term-dot term-dot-amber"></span>
                  <span class="term-dot term-dot-green"></span>
                </span>
                <span class="term-file"
                  >~/projects/unipool.md<span class="term-file-mode">
                    (read-only)</span
                  ></span
                >
                <a
                  class="term-action"
                  href="https://play.google.com/store/apps/details?id=com.carpoolitapp"
                  target="_blank"
                  rel="noreferrer"
                >
                  play store →
                </a>
              </header>

              <div class="term-body">
                <p class="term-cmd-line">
                  <span class="term-dollar">$</span> cat ~/projects/unipool.md<span
                    class="term-caret">_</span
                  >
                </p>

                <h3>UniPool</h3>

                <p>
                  Campus carpooling platform adopted by 600+ students at VIT
                  Vellore.
                </p>

                <div class="term-body-grid">
                  <ul class="term-list">
                    <li>
                      Built Go-Fiber backend with JWT authentication and REST
                      API endpoints.
                    </li>
                    <li>
                      Integrated Firebase and React Native Expo for
                      cross-platform reliability.
                    </li>
                    <li>
                      Dockerized the application and scaled it to 600+ student
                      users.
                    </li>
                  </ul>

                  <div class="term-shots term-shots-inline" data-gallery="car">
                    {
                      galleries.car.map((p, i) => (
                        <button
                          class="hl-thumb term-shot term-shot-mobile"
                          type="button"
                          data-index={i}
                          data-src={p.src}
                          data-alt={p.alt}
                          aria-label={`Open UniPool screenshot ${i + 1} of ${galleries.car.length}`}
                        >
                          <span class="term-shot-frame">
                            <img src={p.src} alt={p.alt} loading="lazy" />
                          </span>
                          <span class="term-shot-name">{p.label}</span>
                        </button>
                      ))
                    }
                  </div>
                </div>

                <div class="term-divider" aria-hidden="true"></div>

                <p class="stack-line">
                  <span class="stack-hash">#</span> stack:
                  <span class="stack-chips">
                    <span class="stack-chip">Go</span>
                    <span class="stack-chip">Go-Fiber</span>
                    <span class="stack-chip">GORM</span>
                    <span class="stack-chip">React Native</span>
                    <span class="stack-chip">Firebase</span>
                    <span class="stack-chip">Docker</span>
                  </span>
                </p>
              </div>
            </article>
          </div>
        </div>
      </article>
    </section>

    <section class="row row-full section" id="research">
      <article class="content-col content-col-full">
        <div class="content-inner project-inner">
          <div class="section-title">// section_04</div>
          <h2 class="heading heading-lg">Research</h2>

          <p class="term-prompt-line">
            <span class="term-user">harshitaa@portfolio</span><span
              class="term-colon">:</span
            ><span class="term-path">~</span><span class="term-dollar">$</span>
            <span class="term-cmd">ls -1 ~/research</span><span
              class="term-caret">_</span
            >
          </p>

          <article class="project-item term-card">
            <header class="term-bar">
              <span class="term-dots" aria-hidden="true">
                <span class="term-dot term-dot-red"></span>
                <span class="term-dot term-dot-amber"></span>
                <span class="term-dot term-dot-green"></span>
              </span>
              <span class="term-file"
                >~/research/parkinsons.md<span class="term-file-mode">
                  (read-only)</span
                ></span
              >
              <a class="term-action" href="#"> paper → </a>
            </header>

            <div class="term-body">
              <p class="term-cmd-line">
                <span class="term-dollar">$</span> cat ~/research/parkinsons.md<span
                  class="term-caret">_</span
                >
              </p>

              <h3>
                Sequential Multimodal ML Framework for Early Parkinson's Risk
                Assessment
              </h3>

              <p>Presented at IEOM Society International Conference 2025.</p>

              <ul class="term-list">
                <li>
                  Processed and standardized longitudinal multimodal PPMI
                  clinical data through dataset merging, missing-value handling,
                  and feature engineering.
                </li>

                <li>
                  Contributed to a transformer-VAE based Parkinson's disease
                  progression model through Bayesian hyperparameter
                  optimization, experimental analysis, and publication.
                </li>
              </ul>

              <div class="term-divider" aria-hidden="true"></div>

              <p class="stack-line">
                <span class="stack-hash">#</span> tags:
                <span class="stack-chips">
                  <span class="stack-chip">Machine Learning</span>
                  <span class="stack-chip">Healthcare AI</span>
                  <span class="stack-chip">Multimodal Learning</span>
                </span>
              </p>
            </div>
          </article>
        </div>
      </article>
    </section>

    <section class="row row-full section" id="highlights">
      <article class="content-col content-col-full">
        <div class="content-inner hl-inner">
          <div class="section-title">// section_05</div>
          <h2 class="heading heading-lg">Highlights</h2>

          <ul class="highlights">
            <li>
              <span class="hl-body">
                <span class="hl-title"
                  >AWS Solutions Architect &mdash; Associate</span
                >
                <span class="hl-meta">Amazon Web Services &middot; SAA-C03</span
                >
              </span>
              <a
                class="hl-link"
                href="https://www.credly.com/badges/925a4633-829e-4ed1-8143-ef0834e421bd/public_url"
                target="_blank"
                rel="noreferrer"
              >
                verify
                <svg
                  viewBox="0 0 24 24"
                  width="11"
                  height="11"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="8 7 17 7 17 16"></polyline>
                </svg>
              </a>
            </li>

            <li>
              <span class="hl-body">
                <span class="hl-title">AWS Cloud Practitioner</span>
                <span class="hl-meta">Amazon Web Services &middot; CLF-C02</span
                >
              </span>
              <a
                class="hl-link"
                href="https://cp.certmetrics.com/amazon/en/public/verify/credential/462b8479ee7246b1ae01f545fb84dd6c"
                target="_blank"
                rel="noreferrer"
              >
                verify
                <svg
                  viewBox="0 0 24 24"
                  width="11"
                  height="11"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="8 7 17 7 17 16"></polyline>
                </svg>
              </a>
            </li>

            <li class="has-photos">
              <span class="hl-body">
                <span class="hl-title">Chairperson &mdash; ACM-W VIT</span>
                <span class="hl-meta">2024 &mdash; 2025</span>
              </span>
              <button
                class="hl-toggle"
                type="button"
                aria-expanded="false"
                aria-controls="photos-acmw"
              >
                <span>photos</span>
                <svg
                  class="t-chev"
                  viewBox="0 0 24 24"
                  width="11"
                  height="11"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
