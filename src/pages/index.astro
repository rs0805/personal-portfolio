    flex-direction: column;
  }

  .row {
    min-height: 100vh;
    display: grid;
    grid-template-columns: minmax(380px, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 5vw, 64px);
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
    padding: 110px var(--gutter) 60px;
    box-sizing: border-box;
    align-items: stretch;
  }

  .art-col {
    align-self: stretch;
    display: flex;
  }
  .art-col > :global(*) {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .content-col {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .content-inner {
    max-width: 70ch;
  }

  .row-full {
    grid-template-columns: 1fr;
  }
  .content-col-full {
    width: 100%;
  }
  .content-col-full .content-inner {
    max-width: none;
  }
  .content-col-full .about-prose,
  .content-col-full .hl-sub {
    max-width: 75ch;
  }

  /* headings -------------------------------------------------------- */
  .heading {
    font-size: 1.35rem;
    margin: 0 0 14px;
    letter-spacing: -0.01em;
  }
  .heading-lg {
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    margin-bottom: 24px;
    letter-spacing: -0.02em;
  }

  /* hero ------------------------------------------------------------ */

  .hero-socials {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .hero-socials a {
    color: var(--text-faint);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition:
      color 0.18s ease,
      transform 0.18s ease;
  }

  .hero-socials a:hover {
    color: var(--accent);
    transform: translateY(-2px);
  }

  .hero-socials svg {
    width: 20px;
    height: 20px;
  }
  .content-inner.hero {
    align-self: center;
    padding-top: 0;
    max-width: 64ch;
  }

  .hero-prompt {
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--text-faint);
    margin: 0 0 22px;
    display: flex;
    align-items: center;
    gap: 4px;
    height: 1.4em;
  }
  .hero-prompt .prompt {
    color: var(--accent);
  }
  .hero-prompt .dollar {
    color: var(--text-dim);
  }

  .typewriter {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    width: 0;
    vertical-align: bottom;
    animation: typing 1.2s steps(13, end) 0.25s forwards;
  }
  @keyframes typing {
    to {
      width: 13ch;
    }
  }

  .hero-prompt .caret {
    display: inline-block;
    width: 7px;
    color: var(--accent);
    animation: blink 1s step-end infinite 1.6s;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .typewriter {
      width: 13ch;
      animation: none;
    }
    .hero-prompt .caret {
      animation: none;
    }
  }

  .hero-title {
    font-size: clamp(2.2rem, 4.6vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    margin: 0 0 20px;
    font-weight: 800;
  }
  .hero-name {
    color: var(--accent);
    background: linear-gradient(120deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-tagline {
    color: var(--text-dim);
    margin: 0 0 36px;
    max-width: 60ch;
    font-size: 15px;
    line-height: 1.75;
  }

  .kw {
    color: var(--text);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
    margin-bottom: 61px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    text-decoration: none;
    border: 1px solid transparent;
    transition:
      transform 0.18s ease,
      background 0.18s ease,
      border-color 0.18s ease,
      color 0.18s ease,
      box-shadow 0.18s ease;
  }
  .btn-primary {
    background: var(--accent-2);
    color: #ffffff;
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow:
      0 6px 18px rgba(5, 150, 105, 0.35),
      0 0 0 1px rgba(16, 185, 129, 0.4);
    filter: brightness(1.08);
    color: #ffffff;
    border-bottom: 1px solid transparent;
  }
  .btn-ghost {
    background: transparent;
    color: var(--text-dim);
    border-color: var(--border);
  }
  .btn-ghost:hover {
    transform: translateY(-2px);
    color: var(--accent);
    border-color: var(--accent);
    background: rgba(16, 185, 129, 0.06);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.35);
    border-bottom: 1px solid var(--accent);
  }

  .hero-now {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 18px 28px;
    padding: 24px 0;
    border-top: 1px dashed var(--border);
    border-bottom: 1px dashed var(--border);
    margin-bottom: 36px;
  }
  .now-item {
    display: grid;
    grid-template-columns: 32px 1fr;
    align-items: start;
    gap: 12px;
  }
  .now-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(16, 185, 129, 0.08);
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(16, 185, 129, 0.18);
  }
  .now-key {
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 4px;
  }
  .now-val {
    font-size: 13px;
    color: var(--text);
    line-height: 1.45;
  }

  .hero-bio {
    color: var(--text-dim);
    font-size: 14px;
    line-height: 1.75;
    max-width: 60ch;
    margin: 0 0 48px;
  }

  .scroll-cue {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--text-faint);
    border-bottom: none;
    width: fit-content;
  }
  .scroll-cue svg {
    animation: bounce 1.8s ease-in-out infinite;
    color: var(--accent);
  }
  .scroll-cue:hover {
    color: var(--accent);
    border-bottom: none;
  }
  @keyframes bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-cue svg {
      animation: none;
    }
  }

  /* about ----------------------------------------------------------- */
  .about-inner {
    padding-top: 8px;
  }

  .about-prose p {
    font-size: 15px;
    line-height: 1.85;
    color: var(--text-dim);
    max-width: 100ch;
    margin: 0 0 18px;
  }
  .about-prose p:last-child {
    margin-bottom: 0;
  }

  .subblock {
    margin-top: 22px;
  }
  .subblock-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .subblock-title {
    color: var(--text);
    font-size: 14px;
    font-weight: 700;
  }
  .subblock-meta {
    color: var(--text-faint);
    font-size: 12px;
    white-space: nowrap;
  }
  .subblock-sub {
    color: var(--text-dim);
    font-size: 12px;
    margin-top: 4px;
  }
  .subblock-lg .subblock-title {
    font-size: 16px;
  }
  .subblock-lg .subblock-sub {
    font-size: 13px;
    margin-top: 6px;
  }
  .subblock-lg .subblock-meta {
    font-size: 13px;
  }

  .skills-kicker {
    margin-top: 40px !important;
  }

  .skills-lines {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--accent);
  }
  .skill-line {
    display: grid;
    grid-template-columns: 180px 1fr;
    align-items: baseline;
    gap: 24px;
    padding: 18px 0;
    border-bottom: 1px solid var(--accent);
    font-size: 14px;
  }
  .skill-line-key {
    color: var(--text);
    font-weight: 700;
    letter-spacing: 0.04em;
    font-size: 13px;
    text-transform: uppercase;
  }
  .skill-line-values {
    color: var(--text-dim);
    white-space: nowrap;
    overflow-x: auto;
    font-size: 14px;
    letter-spacing: 0.02em;
    scrollbar-width: none;
  }
  .skill-line-values::-webkit-scrollbar {
    height: 0;
    display: none;
  }
  .skill-line-values .item {
    color: var(--text-dim);
  }
  .skill-line-values .sep {
    color: var(--accent);
    margin: 0 6px;
    opacity: 0.8;
  }

  @media (max-width: 720px) {
    .skill-line {
      grid-template-columns: 1fr;
      gap: 6px;
      padding: 14px 0;
    }
  }

  /* experience - flip cards ----------------------------------------- */
  .exp-inner {
    padding-top: 8px;
  }

  .exp-hint {
    margin: -8px 0 28px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .exp-hint .sep {
    color: var(--border);
  }
  .exp-hint .dim {
    color: var(--text-faint);
  }

  .exp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    perspective: 1500px;
  }

  .card {
    all: unset;
    box-sizing: border-box;
    display: block;
    width: 100%;
    height: 380px;
    border-radius: 18px;
    cursor: pointer;
    outline: none;
  }
  .card:focus-visible .card-inner {
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.4);
    border-radius: 18px;
  }

  .card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.75s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .card.is-flipped .card-inner {
    transform: rotateY(180deg);
  }
  @media (hover: hover) {
    .card:hover .card-inner {
      transform: rotateY(180deg);
    }
    .card:hover.is-flipped .card-inner {
      transform: rotateY(0deg);
    }
  }

  .card-face {
    position: absolute;
    inset: 0;
    border-radius: 18px;
    padding: 24px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    text-align: left;
  }

  .face-pink {
    background: var(--accent-2);
    color: #ffffff;
  }
  .face-outline {
    background: #0a0a0a;
    border: 1px dashed var(--border);
    color: var(--text);
  }

  .face-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .eyebrow {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .face-outline .eyebrow {
    color: var(--text-faint);
    opacity: 1;
  }

  .live-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.6);
    animation: liveDot 1.6s ease-in-out infinite;
  }
  @keyframes liveDot {
    50% {
      opacity: 0.35;
    }
  }

  .badge {
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: lowercase;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    color: #ffffff;
    white-space: nowrap;
    font-weight: 700;
  }
  .badge-light {
    background: #ffffff;
    color: var(--accent-2);
  }
  .face-outline .badge {
    background: rgba(16, 185, 129, 0.08);
    color: var(--accent);
    border: 1px solid rgba(16, 185, 129, 0.35);
  }

  .face-mid {
    margin: 8px 0;
  }

  .title-big {
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  .title-big.alt {
    background: linear-gradient(120deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .title-sub {
    margin-top: 8px;
    font-size: 13px;
    line-height: 1.5;
    opacity: 0.92;
    max-width: 38ch;
  }
  .face-outline .title-sub {
    color: var(--text-dim);
    opacity: 1;
  }

  .face-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px;
  }

  .meta-strong {
    font-size: 11px;
    letter-spacing: 0.1em;
    opacity: 0.85;
  }
  .face-outline .meta-strong {
    color: var(--text-dim);
    opacity: 1;
  }

  .mini-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .mini-chips span {
    font-size: 10px;
    padding: 3px 8px;
    border-radius: 999px;
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: var(--text-dim);
    white-space: nowrap;
  }

  .flip-hint {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .face-outline .flip-hint {
    color: var(--text-faint);
  }

  .card-back {
    background: #0e0e0e;
    border: 1px solid var(--border);
    color: var(--text);
    transform: rotateY(180deg);
    overflow-y: auto;
  }

  .back-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  .back-eyebrow {
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
  }
  .back-head .back-eyebrow {
    margin-bottom: 0;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--accent);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    border-bottom: 1px dashed transparent;
    white-space: nowrap;
    padding: 2px 0;
  }
  .back-link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .back-link svg {
    transition: transform 0.18s ease;
  }
  .back-link:hover svg {
    transform: translate(2px, -2px);
  }

  .back-list {
    list-style: none;
    margin: 0 0 14px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  .back-list li {
    position: relative;
    padding-left: 16px;
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--text-dim);
  }
  .back-list li::before {
    content: ">";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }
  .back-list .kw {
    color: var(--text);
    font-weight: 600;
  }
  .back-list .num {
    color: var(--accent);
    font-weight: 700;
  }

  .back-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-top: 12px;
    border-top: 1px dashed var(--border);
  }
  .back-chips .chip {
    display: inline-block;
    padding: 3px 9px;
    font-size: 10.5px;
    color: var(--text-dim);
    background: rgba(16, 185, 129, 0.06);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 999px;
    white-space: nowrap;
  }

  @media (max-width: 960px) {
    .exp-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .exp-grid {
      grid-template-columns: 1fr;
    }
    .card {
      height: 340px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card-inner {
      transition: none;
    }
    .live-dot {
      animation: none;
    }
  }

  /* highlights ------------------------------------------------------ */
  .hl-inner {
    padding-top: 8px;
  }

  .hl-sub {
    color: var(--text-dim);
    font-size: 14px;
    line-height: 1.7;
    margin: 0 0 24px;
    max-width: 70ch;
  }

  .highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px dashed var(--border);
  }
  .highlights li {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 24px;
    padding: 20px 16px 20px 28px;
    border-bottom: 1px dashed var(--border);
    position: relative;
    transition:
      padding-left 0.22s ease,
      background 0.22s ease,
      box-shadow 0.22s ease,
      border-color 0.22s ease;
  }
  .highlights li::before {
    content: ">";
    position: absolute;
    left: 0;
    top: 20px;
    color: var(--accent);
    font-weight: 700;
    transition:
      transform 0.22s ease,
      color 0.22s ease;
  }
  .highlights li:hover {
    padding-left: 34px;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.04),
      rgba(16, 185, 129, 0.08) 40%,
      transparent 90%
    );
    box-shadow: inset 2px 0 0 var(--accent);
  }
  .highlights li:hover::before {
    transform: translateX(4px);
    color: #ffffff;
  }
  .highlights li:hover .hl-title {
    color: #ffffff;
  }

  .hl-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .hl-title {
    color: var(--text);
    font-weight: 700;
    font-size: 14.5px;
    line-height: 1.4;
  }
  .hl-meta {
    color: var(--text-faint);
    font-size: 12px;
    letter-spacing: 0.04em;
  }

  .hl-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--accent);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-bottom: 1px dashed transparent;
    white-space: nowrap;
    padding: 4px 0;
  }
  .hl-link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .hl-link svg {
    transition: transform 0.18s ease;
  }
  .hl-link:hover svg {
    transform: translate(2px, -2px);
  }

  /* expandable photo strip ----------------------------------------- */
  .hl-toggle {
    all: unset;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 5px;
    color: var(--accent);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    padding: 4px 0;
  }

  .hl-toggle .t-chev {
    transition: transform 0.22s ease;
  }

  .hl-toggle[aria-expanded="true"] .t-chev {
    transform: rotate(180deg);
  }

  .hl-toggle:hover,
  .hl-toggle:focus-visible {
    outline: none;
  }

  .hl-toggle .t-count {
    font-size: 10px;
    padding: 1px 6px;
    border-radius: 999px;
    background: rgba(16, 185, 129, 0.15);
    color: var(--text);
  }
  .hl-toggle .t-chev {
    transition: transform 0.22s ease;
  }
  .hl-toggle[aria-expanded="true"] .t-chev {
    transform: rotate(180deg);
  }
  .hl-toggle[aria-expanded="true"] {
    background: rgba(16, 185, 129, 0.06);
    border-color: var(--accent);
  }

  .hl-photos {
    grid-column: 1 / -1;
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition:
      max-height 0.35s ease,
      opacity 0.25s ease,
      margin-top 0.25s ease;
    margin-top: 0;
  }
  .hl-photos.is-open {
    max-height: 220px;
    opacity: 1;
    margin-top: 16px;
  }

  .hl-strip {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding: 4px 2px 8px;
    scrollbar-width: thin;
  }
  .hl-strip::-webkit-scrollbar {
    height: 6px;
  }
  .hl-strip::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 3px;
  }

  .hl-thumb {
    all: unset;
    cursor: pointer;
    flex: 0 0 auto;
    width: 120px;
    height: 120px;
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.2s ease;
  }

  .hl-thumb:hover {
    transform: translateY(-2px);
  }

  .hl-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hl-thumb:hover img {
    filter: grayscale(0%);
    transform: scale(1.04);
  }

  /* lightbox ------------------------------------------------------- */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
