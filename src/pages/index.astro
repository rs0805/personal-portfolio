                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </a>

            <div class="hero-socials">
            <a
              href="https://github.com/harshitaak07"
              aria-label="GitHub"
              target="_blank"
              rel="noreferrer"
            >
             <Icon name="mdi:github" />
            </a>

            <a
              href="https://www.linkedin.com/in/harshitaa-kashyap"
              aria-label="LinkedIn"
              target="_blank"
              rel="noreferrer"
            >
              <Icon name="mdi:linkedin" />
            </a>

            <a
              href="https://leetcode.com/u/Harshitaa_Kashyap"
              aria-label="LeetCode"
              target="_blank"
              rel="noreferrer"
            >
              <Icon name="simple-icons:leetcode" />
            </a>
            <a
              href="https://drive.google.com/file/d/1UybeNHW0Qe2zT_JKDRoU8e7kGWa-7_no/view?usp=sharing"
              aria-label="Resume"
              target="_blank"
              rel="noreferrer"
            >
              <Icon name="mdi:file-document-outline" />
            </a>
          </div>
          </div>

          <div class="hero-now">
            <div class="now-item">
              <div class="now-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="7" width="20" height="14" rx="2"/>
                  <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
                  <path d="M2 13h20"/>
                </svg>
              </div>
              <div class="now-body">
                <div class="now-key">Currently</div>
                <div class="now-val">Digital R&amp;D Intern @ <span class="kw">Sanofi</span></div>
              </div>
            </div>

            <div class="now-item">
              <div class="now-icon" aria-hidden="true">
